# ==================================================
# Window focus
# Option + H/J/K/L
# ==================================================

alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east


# ==================================================
# Swap windows
# Option + Shift + H/J/K/L
# ==================================================

shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east


# ==================================================
# Window state
# ==================================================

# Temporary maximize
alt - f : yabai -m window --toggle zoom-fullscreen

# Float / tile
shift + alt - f : yabai -m window --toggle float

# Balance current BSP layout
alt - b : yabai -m space --balance


# ==================================================
# Spaces
# Control + Option + Number
# ==================================================

ctrl + alt - 1 : yabai -m space --focus 1
ctrl + alt - 2 : yabai -m space --focus 2
ctrl + alt - 3 : yabai -m space --focus 3
ctrl + alt - 4 : yabai -m space --focus 4
ctrl + alt - 5 : yabai -m space --focus 5


# ==================================================
# Move window to space
# Control + Option + Shift + Number
# ==================================================

ctrl + shift + alt - 1 : yabai -m window --space 1
ctrl + shift + alt - 2 : yabai -m window --space 2
ctrl + shift + alt - 3 : yabai -m window --space 3
ctrl + shift + alt - 4 : yabai -m window --space 4
ctrl + shift + alt - 5 : yabai -m window --space 5

# ==================================================
# Resize windows
# Control + Option + H/J/K/L
# ==================================================

# Make window narrower from the left
ctrl + alt - h : yabai -m window --resize left:-50:0

# Make window taller downward
ctrl + alt - j : yabai -m window --resize bottom:0:50

# Make window shorter from the bottom
ctrl + alt - k : yabai -m window --resize bottom:0:-50

# Make window wider to the right
ctrl + alt - l : yabai -m window --resize right:50:0

# ==================================================
# Rotate BSP tree
# ==================================================

# Rotate clockwise
shift + alt - r : yabai -m space --rotate 90

# Rotate counter-clockwise
ctrl + alt - r : yabai -m space --rotate 270

# ==================================================
# Focus displays
# ==================================================

ctrl + alt - left  : yabai -m display --focus prev
ctrl + alt - right : yabai -m display --focus next

# ==================================================
# Move window to another display
# ==================================================

ctrl + shift + alt - left  : yabai -m window --display prev
ctrl + shift + alt - right : yabai -m window --display next

# ==================================================
# Create / destroy spaces
# ==================================================

# Create space
cmd + ctrl + alt - n : yabai -m space --create

# Destroy current space
cmd + ctrl + alt - d : yabai -m space --destroy

# ==================================================
# Focus adjacent spaces
# Command + Option + H/L
# ==================================================

cmd + alt - h : yabai -m space --focus prev
cmd + alt - l : yabai -m space --focus next


# ==================================================
# Move window to adjacent space and follow
# Command + Shift + Option + H/L
# ==================================================

cmd + shift + alt - h : \
    yabai -m window --space prev; \
    yabai -m space --focus prev

cmd + shift + alt - l : \
    yabai -m window --space next; \
    yabai -m space --focus next
